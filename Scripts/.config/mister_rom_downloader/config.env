# All paths stay under Scripts/.config/mister_rom_downloader (MiSTer convention).
# Only finished ROMs are written outside ? into /media/fat/games.

MISTER_ROOT="${MISTER_ROOT:-/media/fat}"
APP_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Working data (magnets in, meta/catalog/queue/inbox)
MAGNETS_DIR="${APP_DIR}/magnets"
META_DIR="${APP_DIR}/meta"
CATALOG_DIR="${APP_DIR}/catalog"
SELECTION_DIR="${APP_DIR}/selection"
INBOX_DIR="${APP_DIR}/inbox"
DATS_DIR="${APP_DIR}/dats"
DAT_SOURCES_CONF="${APP_DIR}/dat_sources.conf"
DAT_SOURCES_DEFAULTS="${APP_DIR}/dat_sources.defaults.conf"

# Destination for placed ROMs (MiSTer library)
GAMES_ROOT="${MISTER_ROOT}/games"

ARIA2="${APP_DIR}/bin/aria2c"
ARIA2_CONF="${APP_DIR}/aria2.conf"
CORES_FILE="${APP_DIR}/cores.txt"

ARIA2_BT_MAX_PEERS=32
ARIA2_SPLIT=1

CATALOG_HEADER=$'hash\tindex\tsize\tpath'
QUEUE_FILE="${SELECTION_DIR}/queue.tsv"
